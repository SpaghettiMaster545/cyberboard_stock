{
  "store": "https://store.angrymiao.com",
  "watch": {
    "collections": ["cyberboard-collection"],
    "allProducts": true
  },
  "pollIntervalSeconds": 20,
  "notifyOn": {
    "restock": true,
    "soldOut": true,
    "newProduct": true,
    "priceChange": false,
    "removed": false
  },
  "health": {
    "statusIntervalHours": 24,
    "repeatErrorAlertMinutes": 60
  },
  "requestDelayMs": 400
}
