# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlmNoPqrStuVwXyZ

# Chats that receive alerts and may use the bot's commands.
# Don't know yours? Start the bot and send it /id (or run `npm run chat-id`
# while the bot is stopped). Several are comma-separated: 111111111,-1002222222222
TELEGRAM_CHAT_ID=

# Optional phone push (ntfy app). Usually you just send /push to the bot instead.
# NTFY_TOPIC=stockbot-your-private-topic
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
